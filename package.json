{
  "name": "@signalk/charts-plugin",
  "version": "3.3.0",
  "description": "Signal K plugin to provide chart support for Signal K server",
  "main": "plugin/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup && npm run build:sprites && npm run copy-style-assets && npm run build:runtime-assets",
    "build:runtime-assets": "tsx scripts/build-runtime-assets.ts && tsc -p tsconfig.web.json --noEmit",
    "build:web-assets": "npm run build:runtime-assets",
    "copy-style-assets": "tsx scripts/copy-style-assets.ts",
    "watch": "tsup --watch --onSuccess \"npm run copy-style-assets && npm run build:sprites && npm run build:runtime-assets\"",
    "start": "npm run watch",
    "prepare": "npm run build",
    "prettier": "prettier -w \"src/**/*.{ts,js,css,html,json,md}\" \"scripts/**/*.{ts,js,json,md}\" \"test/**/*.{ts,js,mjs,json,md}\" \"public/**/*.{ts,js,css,html}\"",
    "lint": "eslint \"src/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\" \"test/**/*.{ts,js,mjs}\" \"public/**/*.{ts,js}\" --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint \"src/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\" \"test/**/*.{ts,js,mjs}\" \"public/**/*.{ts,js}\" && prettier --check \"src/**/*.{ts,js,css,html,json,md}\" \"scripts/**/*.{ts,js,json,md}\" \"test/**/*.{ts,js,mjs,json,md}\" \"public/**/*.{ts,js,css,html}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "mocha --node-option import=tsx \"test/**/*.mjs\" \"test/**/*.ts\"",
    "posttest": "node scripts/cleanup-test-uploads.mjs",
    "coverage": "npx c8 --reporter=lcov --reporter=text --exclude test --exclude \"**/*.d.ts\" mocha --node-option import=tsx \"test/**/*.mjs\" \"test/**/*.ts\"",
    "coverage:report": "c8 report --reporter=html && echo 'Coverage report generated at coverage/index.html'",
    "build:sprites": "tsx scripts/build-sprites.ts",
    "sources:generate": "tsx scripts/generate-curated-sources.ts",
    "prepare-arch-package": "node scripts/prepare-arch-package.mjs"
  },
  "c8": {
    "exclude": [
      "src/@types/**",
      "src/types.ts"
    ]
  },
  "license": "Apache-2.0",
  "keywords": [
    "signalk",
    "signalk-node-server-plugin",
    "signalk-webapp",
    "nautic",
    "chart",
    "mbtiles",
    "tms"
  ],
  "author": {
    "name": "Mikko Vesikkala",
    "email": "mikko.vesikkala@iki.fi"
  },
  "dependencies": {
    "@signalk/mbtiles": "0.1.1",
    "@signalk/server-api": "^2.10.2",
    "@turf/bbox": "^7.3.3",
    "@turf/boolean-intersects": "^7.3.3",
    "@turf/helpers": "^7.3.3",
    "check-disk-space": "^3.4.0",
    "geojson-antimeridian-cut": "^0.1.0",
    "geotiff": "^3.0.0",
    "jpeg-js": "^0.4.4",
    "lodash": "^4.17.23",
    "multer": "^2.0.2",
    "node-html-parser": "^7.0.1",
    "p-limit": "^7",
    "pmtiles": "^4.4.0",
    "pngjs": "^7.0.0",
    "xml2js": "0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalK/charts-plugin"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "body-parser": "^2.2.2",
    "c8": "^10.1.2",
    "chai": "6.2.2",
    "chai-http": "5.1.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "globals": "^15.9.0",
    "jsdom": "^28.0.0",
    "mocha": "^11.7.5",
    "pbf": "^4.0.1",
    "prettier": "^3.8.1",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
